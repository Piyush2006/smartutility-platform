# Copy to .env and fill in real values for your environment.
# Postgres via docker-compose:
DATABASE_URL=postgresql+psycopg2://utilityos:utilityos@localhost:5432/utilityos
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]

# Used to build the link inside invite emails (POST /users).
FRONTEND_URL=http://localhost:3000

# Optional. Without these, invite emails aren't actually sent -- the
# invite link is still returned in the API response / shown in the UI so
# the flow keeps working in dev. Example for Gmail: smtp.gmail.com / 587,
# an app password (not your account password) for SMTP_PASSWORD.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
